# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Used only by the optional LLM explanation layer. With these unset the layer
# does not run, every llm_explanation stays null, and no record data leaves
# the machine.

# Infomaniak AI Tools product identifier. Retrievable from the AI Tools
# dashboard, or via GET /1/ai on the Infomaniak API.
INFOMANIAK_PRODUCT_ID=

# Infomaniak API token with AI Tools scope.
INFOMANIAK_API_KEY=

# Optional. Defaults to the confirmed Apertus id below; override only to test
# a different model on the same endpoint.
# LLM_MODEL=swiss-ai/Apertus-v1.5-70B

# Optional. Overrides the whole URL, bypassing INFOMANIAK_PRODUCT_ID. Only
# needed if the endpoint path changes.
# LLM_ENDPOINT=
